# Google Analytics Measurement ID
# Get your ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Groq for /api/chat, /api/transcribe (Whisper), and /api/speech (Orpheus TTS). Create keys at https://console.groq.com/
# Use either a single key, or many (comma / newline / semicolon) for automatic failover on 429:
# GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=gsk_aaa...,gsk_bbb...,gsk_ccc...
GROQ_API_KEY=
GROQ_API_KEYS=
#
# Read-aloud (Orpheus TTS): the Groq org admin must accept model terms once, then retry:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
